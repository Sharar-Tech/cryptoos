# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

# Your Binance/Bybit API keys (read + trade only — NO withdrawal permission)
EXCHANGE_API_KEY=your_api_key_here
EXCHANGE_API_SECRET=your_api_secret_here

# Exchange: binance or bybit
EXCHANGE=binance

# Starting capital in USDT (KES 1000 ≈ $7-10 USDT)
CAPITAL_USDT=10

# Safety limits
DAILY_LOSS_LIMIT_PCT=5
TRADE_SIZE_PCT=10
MAX_DAILY_TRADES=20
STOP_LOSS_PCT=2
TAKE_PROFIT_PCT=3

# Trading pair
DEFAULT_SYMBOL=BTC/USDT

# Database path (SQLite file)
DB_PATH=cryptoos.db
